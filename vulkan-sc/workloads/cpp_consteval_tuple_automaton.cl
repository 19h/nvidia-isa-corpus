// Tables generated by automaton-tables.cpp from the original C++ source.
#define StateCount 8
#define Alphabet 6
#define InputCount 97
#define Fingerprint 13794443259760431322UL
__constant uchar TableNext[48] = {
    6UL, 6UL, 5UL, 2UL, 5UL, 2UL, 3UL, 6UL,
    6UL, 0UL, 5UL, 4UL, 4UL, 0UL, 5UL, 7UL,
    1UL, 7UL, 0UL, 1UL, 5UL, 0UL, 5UL, 5UL,
    2UL, 6UL, 1UL, 3UL, 4UL, 3UL, 6UL, 1UL,
    5UL, 5UL, 2UL, 2UL, 1UL, 0UL, 4UL, 2UL,
    7UL, 7UL, 4UL, 5UL, 0UL, 5UL, 3UL, 2UL,
};
__constant uint TableEmit[48] = {
    3162UL, 5706UL, 9885UL, 16935UL, 3196UL, 5664UL, 6897UL, 8482UL,
    21869UL, 49008UL, 6917UL, 8534UL, 15097UL, 17771UL, 47402UL, 82289UL,
    15131UL, 17632UL, 3793UL, 11918UL, 28273UL, 61404UL, 3725UL, 11954UL,
    5078UL, 1618UL, 10508UL, 29766UL, 5103UL, 1255UL, 7313UL, 21358UL,
    52687UL, 128724UL, 7509UL, 21234UL, 15362UL, 3539UL, 25143UL, 49018UL,
    15548UL, 3417UL, 6778UL, 26911UL, 36697UL, 82012UL, 6980UL, 27149UL,
};
__constant uchar TableAccepting[8] = {
    1UL, 0UL, 0UL, 1UL, 0UL, 1UL, 0UL, 1UL,
};
__constant ulong TableRowSalt[8] = {
    10579051935141637505UL, 1568346954189095923UL, 12247910375399542852UL, 11947272310213769910UL, 1886750193840511883UL, 3662474740621654578UL, 12661661485259928361UL, 5447800544570504557UL,
};
__constant uchar Input[97] = {
    1UL, 3UL, 0UL, 3UL, 5UL, 3UL, 2UL, 4UL,
    3UL, 0UL, 2UL, 4UL, 3UL, 5UL, 4UL, 3UL,
    5UL, 3UL, 2UL, 0UL, 3UL, 0UL, 0UL, 0UL,
    1UL, 3UL, 2UL, 3UL, 3UL, 5UL, 4UL, 0UL,
    5UL, 2UL, 0UL, 4UL, 3UL, 3UL, 0UL, 5UL,
    5UL, 5UL, 0UL, 2UL, 5UL, 0UL, 4UL, 2UL,
    5UL, 3UL, 0UL, 3UL, 1UL, 5UL, 2UL, 2UL,
    1UL, 2UL, 0UL, 0UL, 1UL, 5UL, 4UL, 3UL,
    5UL, 1UL, 0UL, 2UL, 3UL, 0UL, 2UL, 4UL,
    1UL, 5UL, 4UL, 3UL, 1UL, 3UL, 4UL, 0UL,
    3UL, 0UL, 0UL, 4UL, 1UL, 1UL, 0UL, 3UL,
    5UL, 3UL, 4UL, 0UL, 5UL, 2UL, 2UL, 4UL,
    3UL,
};

static ulong rotl64(ulong value, unsigned shift) {
    shift &= 63U;
    return shift == 0U ? value : ((value << shift) | (value >> (64U - shift)));
}

static ulong mix64(ulong value) {
    value ^= value >> 31;
    value *= 0x7fb5d329728ea185ULL;
    value ^= value >> 27;
    value *= 0x81dadef4bc2dd44dULL;
    value ^= value >> 33;
    return value;
}

static ulong run_automaton(uchar *final_state) {
    ushort visits[StateCount] = {0};
    ulong checksum = Fingerprint;
    uchar state = 0;
    uchar shadow = 3;

    for (size_t round = 0; round < 11; ++round) {
        for (size_t i = 0; i < InputCount; ++i) {
            const uchar raw = Input[(i * 17U + round * 5U) % InputCount];
            const uchar symbol = (uchar)((raw + state + shadow + round) % Alphabet);
            const size_t offset = (size_t)(state) * Alphabet + symbol;
            const uchar next = TableNext[offset];
            const ulong emitted = TableEmit[offset] + TableRowSalt[next];

            if (TableAccepting[next] != 0U) {
                checksum = mix64(rotl64(checksum ^ emitted, (unsigned)((symbol + round) & 31U)));
            } else if (((emitted + checksum + i) & 3ULL) == 0ULL) {
                checksum ^= mix64(emitted + (ulong)(state * 4099U + next));
            } else {
                checksum = mix64(checksum + emitted + (ulong)(symbol * 97U));
            }

            ++visits[next];
            shadow = (uchar)((shadow + next + symbol + (checksum & 7ULL)) % StateCount);
            state = (uchar)((next ^ (shadow & 1U)) % StateCount);
        }
    }

    for (size_t i = 0; i < StateCount; ++i) {
        const ulong folded = (ulong)(visits[i]) * (i + 19ULL);
        checksum = mix64(checksum ^ folded ^ TableRowSalt[i]);
    }

    *final_state = state;
    return checksum ^ (ulong)(shadow);
}

__attribute__((reqd_work_group_size(1, 1, 1)))
__kernel void program_entry(__global uint *results) {
    uchar state;
    ulong checksum = run_automaton(&state);
    results[0] = 0;
    for (uint byte = 0; byte < 8; ++byte)
        results[1 + byte] = (uint)((checksum >> (8u * byte)) & 255UL);
    results[17] = state;
}
