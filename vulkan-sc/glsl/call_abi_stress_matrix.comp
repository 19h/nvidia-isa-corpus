/*
 * call_abi_stress_matrix.c
 *
 * Dense call matrix with mixed scalar and aggregate ABI traffic.
 * Stresses calls, returns, varargs, pointer aliasing, and integer/FP mixing.
 */


#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) writeonly buffer Result { uint words[]; } output_data;

uint byte_value(uint x) { return x & 255u; }
uint byte_value(uint64_t x) { return uint(x & 255UL); }


struct Packet {
    uint64_t lo;
    uint64_t hi;
    uint tag;
    uint lane[6];
};

struct Mixed {
    double d0;
    double d1;
    float f0;
    float f1;
    uint64_t u;
    int i;
};

struct BigMatrix {
    uint64_t row[4][3];
    uint bias[5];
};

struct AliasBox {
    uint cell[4][4];
    uint pad[16];
};

uint rotl32(uint value, uint amount) {
    amount &= 31u;
    return amount == 0u ? value : (value << amount) | (value >> (32u - amount));
}

uint64_t rotl64(uint64_t value, uint amount) {
    amount &= 63u;
    return amount == 0u ? value : (value << amount) | (value >> (64u - amount));
}

uint64_t mix64(uint64_t value) {
    value ^= value >> 30u;
    value *= 0xbf58476d1ce4e5b9UL;
    value ^= value >> 27u;
    value *= 0x94d049bb133111ebUL;
    value ^= value >> 31u;
    return value;
}

Packet make_packet(uint64_t seed,
                          uint a0, uint a1, uint a2, uint a3,
                          uint a4, uint a5, uint a6, uint a7,
                          uint mode) {
    Packet packet;
    uint64_t folded = seed ^ (uint64_t(a0) << 32u) ^ a7;

    packet.lo = mix64(folded + a1 + (uint64_t(a2) << 17u));
    packet.hi = mix64(seed ^ (uint64_t(a3) << 41u) ^ (uint64_t(a4) << 9u));
    packet.tag = uint(packet.lo ^ (packet.hi >> 32u) ^ a5 ^ rotl32(a6, mode));

    for (uint i = 0; i < 6u; ++i) {
        packet.lane[i] = byte_value(packet.tag >> ((i & 3u) * 8u));
        packet.lane[i] ^= byte_value(seed >> ((i + 1u) * 7u));
    }

    return packet;
}

Packet route_alpha(Packet packet, uint64_t salt, uint round) {
    packet.lo += mix64(salt ^ packet.hi ^ round);
    packet.hi ^= rotl64(packet.lo + packet.tag, (round & 31u) + 1u);
    packet.tag += uint(packet.lo >> 32u) ^ round;
    packet.lane[round % 6u] ^= byte_value(packet.tag >> 5u);
    return packet;
}

Packet route_beta(Packet packet, uint64_t salt, uint round) {
    packet.hi += mix64(salt + packet.lo + 0x51ed2705UL);
    packet.lo ^= rotl64(packet.hi ^ packet.tag, (round & 15u) + 11u);
    packet.tag = rotl32(packet.tag ^ uint(salt), (round & 7u) + 1u);
    packet.lane[(round + 2u) % 6u] = byte_value(packet.lane[(round + 2u) % 6u] + uint(packet.lo >> 11u));
    return packet;
}

Packet route_gamma(Packet packet, uint64_t salt, uint round) {
    uint64_t bridge = mix64(packet.lo + packet.hi + salt + round);
    packet.lo += bridge ^ rotl64(packet.hi, 9u);
    packet.hi += rotl64(bridge, 29u) ^ packet.lo;
    packet.tag ^= uint(bridge >> 24u) + round;
    packet.lane[(round + 5u) % 6u] ^= byte_value(bridge >> 48u);
    return packet;
}

Packet route_packet(uint route, Packet packet, uint64_t checksum, uint round) {
    switch (route) {
        case 0: return route_alpha(packet, checksum, round);
        case 1: return route_beta(packet, checksum, round);
        default: return route_gamma(packet, checksum, round);
    }
}

void alias_box(inout AliasBox box, inout Packet packet, uint round) {
    uint r1 = round & 3u, c1 = (round >> 2u) & 3u;
    uint r2 = (round + 1u) & 3u, c2 = (round + 3u) & 3u;
    uint mixed = rotl32(box.cell[r1][c1] + packet.tag + round, (round & 15u) + 1u);
    box.cell[r1][c1] ^= mixed + box.cell[r2][c2];
    box.cell[r2][c2] += rotl32(box.cell[r1][c1] ^ uint(packet.lo), ((round >> 4u) & 15u) + 1u);
    uint byte_offset = (round * 5u + packet.lane[round % 6u]) & 63u;
    uint value = byte_value(box.cell[r1][c1] >> ((round & 3u) * 8u));
    box.cell[byte_offset / 16u][(byte_offset % 16u) / 4u] ^= value << ((byte_offset & 3u) * 8u);
    uint lane_index = (round + box.cell[r2][c2]) % 6u;
    packet.lane[lane_index] = byte_value(packet.lane[lane_index] + (box.cell[r2][c2] >> 13u));
    packet.tag ^= box.cell[r1][c1] + rotl32(box.cell[r2][c2], 7u);
}

Mixed make_mixed(Packet packet, double scale, float bend, uint64_t extra) {
    Mixed mixed;
    uint low = uint(packet.lo ^ extra);
    uint high = uint((packet.hi >> 32u) ^ packet.tag);

    mixed.d0 = double(low & 0xffffu) * scale + 0.5LF;
    mixed.d1 = double(high & 0xffffu) * 0.25LF + double(packet.lane[0]);
    mixed.f0 = float(packet.lane[1] + packet.lane[2]) * bend;
    mixed.f1 = float(packet.lane[3] ^ packet.lane[4]) * 0.125f;
    mixed.u = mix64(packet.lo + packet.hi + extra);
    mixed.i = int((low ^ high) & 0x3fffffffu);
    return mixed;
}

BigMatrix fill_matrix(Packet packet, Mixed mixed, uint salt) {
    BigMatrix matrix;
    uint64_t base = packet.lo ^ packet.hi ^ mixed.u ^ salt;

    for (uint r = 0; r < 4u; ++r) {
        for (uint c = 0; c < 3u; ++c) {
            uint64_t lane = packet.lane[(r + c) % 6u];
            matrix.row[r][c] = mix64(base + lane + uint64_t(r * 13u + c * 29u));
        }
    }
    for (uint i = 0; i < 5u; ++i) {
        matrix.bias[i] = uint(mix64(base + i * 0x100000001b3UL));
    }

    return matrix;
}

BigMatrix twist_matrix(BigMatrix matrix, Packet packet,
                              uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
                              uint64_t a4, uint64_t a5, uint64_t a6, uint64_t a7) {
    uint64_t args[8] = uint64_t[8](a0, a1, a2, a3, a4, a5, a6, a7);

    for (uint r = 0; r < 4u; ++r) {
        for (uint c = 0; c < 3u; ++c) {
            uint64_t salt = args[(r * 3u + c) & 7u] ^ packet.lane[(r + c) % 6u];
            matrix.row[r][c] = rotl64(matrix.row[r][c] + salt, uint(r + c + 1u));
        }
    }
    for (uint i = 0; i < 5u; ++i) {
        matrix.bias[i] ^= uint(args[(i + packet.tag) & 7u] >> (i * 5u));
    }

    return matrix;
}

uint64_t consume_matrix(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
                               uint64_t a4, uint64_t a5, uint64_t a6, uint64_t a7,
                               uint64_t a8, uint64_t a9, uint64_t a10, uint64_t a11,
                               Packet packet, Mixed mixed, BigMatrix matrix) {
    uint64_t acc = a0 ^ rotl64(a1, 3u) ^ rotl64(a2, 7u) ^ rotl64(a3, 11u);
    acc += a4 ^ rotl64(a5, 17u) ^ rotl64(a6, 23u) ^ rotl64(a7, 29u);
    acc ^= a8 + rotl64(a9, 31u) + rotl64(a10, 37u) + rotl64(a11, 41u);
    acc += packet.lo ^ packet.hi ^ packet.tag;

    for (uint r = 0; r < 4u; ++r) {
        for (uint c = 0; c < 3u; ++c) {
            acc ^= mix64(matrix.row[r][c] + matrix.bias[(r + c) % 5u] + acc);
        }
    }

    acc += uint64_t(mixed.d0 * 4096.0LF);
    acc ^= uint64_t(mixed.d1 * 2048.0LF);
    acc += uint64_t(mixed.f0 * 1024.0f);
    acc ^= uint64_t(mixed.f1 * 512.0f);
    acc += mixed.u ^ uint(mixed.i);
    return mix64(acc);
}

// The source's fixed "uidP" pattern becomes four typed shader parameters.
uint64_t fold_arguments(uint64_t u, int i, double d, Packet packet) {
    uint64_t acc = 0xcbf29ce484222325UL;
    acc ^= mix64(u + acc);
    acc += mix64(uint(i) ^ acc);
    acc ^= uint64_t(d * 8192.0LF);
    acc += packet.lo ^ rotl64(packet.hi, 21u) ^ packet.tag;
    for (uint j = 0; j < 6u; ++j)
        acc ^= uint64_t(packet.lane[j]) << (j * 8u);
    return mix64(acc);
}

void main() {
    AliasBox box;
    uint64_t checksum = 0x0123456789abcdefUL;

    for (uint r = 0; r < 4u; ++r) {
        for (uint c = 0; c < 4u; ++c) {
            box.cell[r][c] = uint(mix64(uint64_t(r) * 17u + c * 41u + 3u));
        }
    }
    for (uint i = 0; i < 16u; ++i) {
        box.pad[i] = byte_value(i * 19u + 7u);
    }

    Packet packet = make_packet(0xfeedfacecafebeefUL,
                                1u, 3u, 5u, 7u, 11u, 13u, 17u, 19u, 5u);

    for (uint round = 0; round < 3072u; ++round) {
        alias_box(box, packet, round);

        uint route = (box.cell[round & 3u][(round >> 3u) & 3u] ^ packet.tag ^ round) % 3u;
        packet = route_packet(route, packet, checksum, round);

        Mixed mixed = make_mixed(packet, 0.5LF + double(round & 7u) * 0.125LF,
                                 0.25f + float(round & 3u) * 0.125f,
                                 checksum);
        BigMatrix matrix = fill_matrix(packet, mixed, round ^ box.cell[(round + 1u) & 3u][round & 3u]);

        matrix = twist_matrix(matrix, packet,
                              checksum,
                              checksum + round,
                              packet.lo,
                              packet.hi,
                              mixed.u,
                              uint64_t(box.cell[0][round & 3u]),
                              uint64_t(box.cell[1][(round + 1u) & 3u]),
                              uint64_t(box.cell[2][(round + 2u) & 3u]));

        uint64_t call_sum = consume_matrix(checksum,
                                           checksum ^ packet.lo,
                                           checksum + packet.hi,
                                           uint64_t(packet.tag) << 32u,
                                           mixed.u,
                                           matrix.row[0][0],
                                           matrix.row[1][1],
                                           matrix.row[2][2],
                                           matrix.row[3][0],
                                           box.cell[0][0],
                                           box.cell[1][1],
                                           box.cell[2][2],
                                           packet,
                                           mixed,
                                           matrix);

        checksum ^= call_sum + fold_arguments(
                                             uint64_t(round),
                                             int(round & 32767u),
                                             0.125LF + double(round & 15u) * 0.0625LF,
                                             packet);
        checksum = mix64(checksum + matrix.row[round & 3u][round % 3u]);
    }

    uint64_t sink = checksum ^ packet.lo ^ rotl64(packet.hi, 33u);
    output_data.words[0] = 0;
    for (uint i = 0; i < 8; ++i)
        output_data.words[1+i] = uint((sink >> (8u*i)) & 255UL);
}
