// The threaded VM dispatches named continuation slots in a shader loop.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Result {
    uint words[64];
    uint fence;
} output_data;

uint byte_value(uint value) { return value & 255u; }
// SPDX-License-Identifier: MIT
/*
 * Setjmp/longjmp threaded bytecode VM.
 *
 * This stays within portable C11 control-flow constructs while still making
 * dispatch awkward: every interpreter state is a saved continuation, and the
 * bytecode handlers bounce between them with longjmp instead of a loop.
 */





const uint SLOT_BOOT = 0u;
const uint SLOT_FETCH = 1u;
const uint SLOT_ALU = 2u;
const uint SLOT_MEM = 3u;
const uint SLOT_BRANCH = 4u;
const uint SLOT_CALL = 5u;
const uint SLOT_TWIST = 6u;
const uint SLOT_HALT = 7u;
const uint SLOT_COUNT = 8u;

const uint OP_LIT = 1u;
const uint OP_ALU = 2u;
const uint OP_MEM = 3u;
const uint OP_JUMP = 4u;
const uint OP_JZ = 5u;
const uint OP_LOOP = 6u;
const uint OP_CALL = 7u;
const uint OP_RET = 8u;
const uint OP_TWIST = 9u;
const uint OP_HALT = 10u;

struct Insn {
    uint op;
    uint arg;
};

struct Frame {
    uint ret_pc;
    uint salt;
};

struct Vm {
    uint regs[4];
    uint stack[16];
    uint mem[16];
    Frame frames[4];
    uint trace;
    uint opcode;
    uint operand;
    uint pc;
    uint sp;
    uint fp;
    uint loop;
    uint fuel;
    uint phase;
};








uint rotl32(uint value, uint amount) {
    amount &= 31u;
    return amount == 0u ? value : (value << amount) | (value >> (32u - amount));
}

uint mix32(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}


uint alu_addfold(uint a, uint b) {
    return mix32(a + rotl32(b, 5u));
}


uint alu_xorlace(uint a, uint b) {
    return rotl32(a ^ mix32(b + 0x9e3779b9u), (a >> 27u) + 1u);
}


uint alu_mulbias(uint a, uint b) {
    return (a | 1u) * (b ^ 0x45d9f3bu) + rotl32(a, 11u);
}


uint alu_mux(uint a, uint b) {
    uint mask = 0u - ((a ^ b) & 1u);
    return (a & mask) | (rotl32(b, 13u) & ~mask);
}

uint dispatch_alu(uint op, uint a, uint b) {
    switch (op) {
        case 0: return alu_addfold(a, b);
        case 1: return alu_xorlace(a, b);
        case 2: return alu_mulbias(a, b);
        default: return alu_mux(a, b);
    }
}

void push(inout Vm vm, uint value) {
    if (vm.sp < 16u) {
        vm.stack[vm.sp++] = value;
    } else {
        vm.trace ^= mix32(value ^ vm.stack[(value >> 3u) & 15u]);
    }
}

uint pop(inout Vm vm) {
    if (vm.sp != 0u) {
        return vm.stack[--vm.sp];
    }
    vm.trace = mix32(vm.trace + 0x31415927u);
    return vm.trace;
}

void init_vm(inout Vm vm, uint seed) {
    vm.regs[0] = seed ^ 0x243f6a88u;
    vm.regs[1] = mix32(seed + 0x85a308d3u);
    vm.regs[2] = 0x13198a2eu;
    vm.regs[3] = 0x03707344u ^ (seed << 1u);
    vm.trace = mix32(seed ^ 0xa4093822u);
    vm.opcode = 0u;
    vm.operand = 0u;
    vm.pc = 0u;
    vm.sp = 0u;
    vm.fp = 0u;
    vm.loop = byte_value(13u + (seed & 7u));
    vm.fuel = 0u;
    vm.phase = byte_value((seed >> 5u) & 3u);

    for (uint i = 0u; i < 16u; ++i) {
        vm.stack[i] = 0u;
        vm.mem[i] = mix32(seed + i * 0x10204081u);
    }
    for (uint i = 0u; i < 4u; ++i) {
        vm.frames[i].ret_pc = 0u;
        vm.frames[i].salt = mix32(seed ^ (i + 0x55aa00ffu));
    }
}


uint run_threaded_vm(const Insn code[30], uint code_len, uint seed) {
    Vm vm;

    init_vm(vm, seed);

    uint continuation = SLOT_BOOT;
    output_data.fence = vm.trace ^ SLOT_BOOT;
    for (;;) {
        if (continuation != SLOT_HALT && vm.fuel++ >= 220u) {
            continuation = SLOT_HALT;
            output_data.fence = vm.trace ^ SLOT_HALT;
        }
        switch (continuation) {
            case SLOT_BOOT: {
                vm.trace ^= rotl32(vm.regs[0] + vm.regs[1], 7u);
                push(vm, vm.trace ^ 0x6a09e667u);
                { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
            }
            case SLOT_FETCH: {
                if (vm.pc >= code_len) {
                    { continuation = SLOT_HALT; output_data.fence = vm.trace ^ continuation; continue; }
                } else {
                    const Insn ins = code[vm.pc++];
                    vm.opcode = ins.op;
                    vm.operand = ins.arg;
                    vm.phase = byte_value((vm.phase + ins.op + (ins.arg & 3u)) & 3u);
                    vm.trace += mix32((uint(ins.op) << 8u) | ins.arg | vm.regs[vm.phase]);

                    switch (ins.op) {
                        case OP_LIT:
                            push(vm, mix32(uint(ins.arg) + vm.trace));
                            { continuation = (vm.trace & 8u) != 0u ? SLOT_TWIST : SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                        case OP_ALU:
                            { continuation = SLOT_ALU; output_data.fence = vm.trace ^ continuation; continue; }
                        case OP_MEM:
                            { continuation = SLOT_MEM; output_data.fence = vm.trace ^ continuation; continue; }
                        case OP_JUMP:
                        case OP_JZ:
                        case OP_LOOP:
                            { continuation = SLOT_BRANCH; output_data.fence = vm.trace ^ continuation; continue; }
                        case OP_CALL:
                        case OP_RET:
                            { continuation = SLOT_CALL; output_data.fence = vm.trace ^ continuation; continue; }
                        case OP_TWIST:
                            { continuation = SLOT_TWIST; output_data.fence = vm.trace ^ continuation; continue; }
                        default:
                            { continuation = SLOT_HALT; output_data.fence = vm.trace ^ continuation; continue; }
                    }
                }
            }
            case SLOT_ALU: {
                {
                    uint b = pop(vm);
                    uint a = pop(vm);
                        uint output_value = dispatch_alu((vm.operand ^ vm.phase ^ vm.sp) & 3u, a ^ vm.regs[1], b + vm.regs[2]);
                    uint slot = (output_value ^ vm.operand ^ vm.trace) & 3u;

                    vm.regs[slot] ^= output_value + rotl32(vm.trace, slot + 3u);
                    vm.trace = mix32(vm.trace ^ output_value ^ vm.regs[(slot + 1u) & 3u]);
                    push(vm, output_value);

                    switch ((output_value >> 29u) & 3u) {
                        case 0u:
                            { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                        case 1u:
                            { continuation = SLOT_MEM; output_data.fence = vm.trace ^ continuation; continue; }
                        case 2u:
                            { continuation = SLOT_TWIST; output_data.fence = vm.trace ^ continuation; continue; }
                        default:
                            { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                    }
                }
            }
            case SLOT_MEM: {
                {
                    uint index = (vm.operand ^ vm.regs[0] ^ vm.trace) & 15u;
                    uint mode = (vm.operand >> 4u) & 3u;

                    switch (mode) {
                        case 0u:
                            { uint popped = pop(vm); vm.mem[index] = popped ^ rotl32(vm.trace, index & 15u); }
                            break;
                        case 1u:
                            push(vm, vm.mem[index] + mix32(vm.regs[index & 3u]));
                            break;
                        case 2u:
                            {
                                uint other = (index + 7u + vm.phase) & 15u;
                                uint tmp = vm.mem[index];
                                vm.mem[index] = vm.mem[other] ^ vm.trace;
                                vm.mem[other] = tmp + vm.regs[other & 3u];
                            }
                            break;
                        default:
                            vm.mem[index] ^= dispatch_alu(index & 3u, vm.trace, vm.regs[vm.phase]);
                            push(vm, vm.mem[index]);
                            break;
                    }

                    vm.trace ^= mix32(vm.mem[index] + index + vm.sp);
                    if (((vm.trace ^ vm.regs[2]) & 11u) == 3u) {
                        { continuation = SLOT_TWIST; output_data.fence = vm.trace ^ continuation; continue; }
                    }
                    { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                }
            }
            case SLOT_BRANCH: {
                switch (vm.opcode) {
                    case OP_JUMP:
                        vm.pc = byte_value(vm.operand % code_len);
                        vm.trace ^= 0xb7e15162u;
                        { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                    case OP_JZ:
                        if ((pop(vm) & 1u) == 0u) {
                            vm.pc = byte_value(vm.operand % code_len);
                            vm.trace += 0x9e3779b9u;
                            { continuation = SLOT_TWIST; output_data.fence = vm.trace ^ continuation; continue; }
                        }
                        { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                    case OP_LOOP:
                        vm.loop = byte_value(vm.loop - 1u);
                        if (vm.loop != 0u) {
                            vm.pc = byte_value(vm.operand % code_len);
                            vm.trace = rotl32(vm.trace ^ vm.loop, (vm.loop & 7u) + 1u);
                            { continuation = (vm.loop & 1u) != 0u ? SLOT_FETCH : SLOT_MEM; output_data.fence = vm.trace ^ continuation; continue; }
                        }
                        { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                    default:
                        { continuation = SLOT_HALT; output_data.fence = vm.trace ^ continuation; continue; }
                }
            }
            case SLOT_CALL: {
                if (vm.opcode == OP_CALL) {
                    if (vm.fp < 4u) {
                        uint frame = vm.fp++;
                        vm.frames[frame].ret_pc = vm.pc;
                        vm.frames[frame].salt = vm.trace ^ vm.regs[vm.fp & 3u];
                        vm.pc = byte_value(vm.operand % code_len);
                        vm.trace += mix32(vm.frames[frame].salt + vm.fp);
                        { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                    }
                    { continuation = SLOT_TWIST; output_data.fence = vm.trace ^ continuation; continue; }
                } else {
                    if (vm.fp != 0u) {
                        uint frame = --vm.fp;
                        vm.pc = vm.frames[frame].ret_pc;
                        vm.trace ^= mix32(vm.frames[frame].salt ^ vm.pc);
                        { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                    }
                    { continuation = SLOT_HALT; output_data.fence = vm.trace ^ continuation; continue; }
                }
            }
            case SLOT_TWIST: {
                {
                    uint lane = (vm.operand + vm.phase + vm.fuel) & 3u;
                    uint folded = mix32(vm.trace ^ vm.regs[lane] ^ vm.mem[(vm.operand + lane) & 15u]);
                    vm.regs[lane] = rotl32(vm.regs[lane] + folded, (vm.operand & 15u) + 1u);
                    vm.mem[(folded >> 4u) & 15u] ^= vm.regs[lane] + vm.sp;
                    push(vm, folded ^ vm.regs[(lane + 1u) & 3u]);

                    switch ((folded ^ vm.trace) & 7u) {
                        case 0u:
                        case 5u:
                            { continuation = SLOT_ALU; output_data.fence = vm.trace ^ continuation; continue; }
                        case 2u:
                            { continuation = SLOT_MEM; output_data.fence = vm.trace ^ continuation; continue; }
                        default:
                            { continuation = SLOT_FETCH; output_data.fence = vm.trace ^ continuation; continue; }
                    }
                }
            }
            case SLOT_HALT: {
        uint output_value = vm.trace ^ (uint(vm.sp) << 24u) ^ vm.loop;
        for (uint i = 0u; i < 4u; ++i) {
            output_value ^= rotl32(vm.regs[i], i * 5u + 3u);
            output_value += mix32(vm.mem[i * 3u] ^ vm.mem[i * 3u + 1u]);
        }
        return mix32(output_value);
    }
            default: return 0;
        }
    }
}

void main() {
    const Insn program[30] = Insn[30](
        Insn(OP_LIT, 0x31u), Insn(OP_LIT, 0x07u), Insn(OP_ALU, 0x00u),
        Insn(OP_MEM, 0x02u), Insn(OP_CALL, 0x12u), Insn(OP_MEM, 0x1du),
        Insn(OP_ALU, 0x05u), Insn(OP_JZ, 0x0cu),  Insn(OP_TWIST, 0xa3u),
        Insn(OP_CALL, 0x18u), Insn(OP_LOOP, 0x04u), Insn(OP_JUMP, 0x1du),
        Insn(OP_TWIST, 0x5eu), Insn(OP_MEM, 0x2bu), Insn(OP_ALU, 0x12u),
        Insn(OP_LOOP, 0x06u), Insn(OP_HALT, 0x00u), Insn(OP_TWIST, 0x91u),
        Insn(OP_LIT, 0x0bu), Insn(OP_ALU, 0x23u), Insn(OP_MEM, 0x35u),
        Insn(OP_RET, 0x00u), Insn(OP_LIT, 0xc7u), Insn(OP_ALU, 0x31u),
        Insn(OP_TWIST, 0x44u), Insn(OP_MEM, 0x4fu), Insn(OP_RET, 0x00u),
        Insn(OP_LIT, 0x55u), Insn(OP_ALU, 0x02u), Insn(OP_HALT, 0x00u)
    );
    uint64_t checksum = 0xcbf29ce484222325UL;

    for (uint round = 0u; round < 64u; ++round) {
        uint seed = mix32(uint(checksum) ^ round * 0x9e3779b9u);
        uint output_value = run_threaded_vm(program, 30u, seed);
        checksum ^= uint64_t(output_value) + 0x100000001b3UL;
        checksum = (checksum << 9u) | (checksum >> 55u);
    }

    output_data.words[0] = 0;
    for (uint i = 0; i < 8; ++i)
        output_data.words[1+i] = uint((checksum >> (8u*i)) & 255UL);
}
