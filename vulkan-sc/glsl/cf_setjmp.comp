// The original non-local targets become explicit continuations. This
// preserves the workload results without depending on a host stack ABI.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) writeonly buffer Result { uint words[]; } output_data;

int basic_jump(int trigger) {
    return trigger > 0 ? trigger * 10 : -1;
}

int nested_jump(int depth) {
    int value = 1;
    for (; depth > 0; --depth)
        ++value;
    return value;
}

int process_with_errors(int value) {
    if (value < 0) return -1;
    if (value > 100) return -2;
    if (value == 42) return -42;
    return value * value;
}

int multi_jump(int selector) {
    switch (selector % 4) {
        case 0: return 999;
        case 1: return 100;
        case 2: return 400;
        default: return 900;
    }
}

int64_t jump_loop(int iterations) {
    int64_t sum = 0;
    int jumped = 0;
    int i = 0;
    for (;;) {
        sum += jumped;
        if (i >= iterations) return sum;
        int value = i * i;
        ++i;
        if (i % 7 == 0) {
            jumped = value == 0 ? 1 : value;
            continue;
        }
        sum += value;
        if (i >= iterations) return sum;
        jumped = 1; // longjmp with a zero argument returns one.
    }
}

int64_t coroutine_switches(int count) {
    int64_t worker_value = 0;
    for (int i = 0; i < count; ++i) {
        int shared_value = i;
        worker_value += shared_value;
    }
    return worker_value;
}

int use_resources(int count) {
    int resources[4];
    int allocated = 0;
    for (int i = 0; i < count; ++i) {
        resources[allocated++] = i;
        if (allocated == 4) {
            int cleaned = 0;
            while (allocated > 0) {
                --allocated;
                ++cleaned;
            }
            return -cleaned;
        }
    }

    int total = 0;
    while (allocated > 0)
        total += resources[--allocated];
    return total;
}

int jump_state_machine(int input_value) {
    int state = 0;
    int result = 0;
    for (;;) {
        switch (state) {
            case 0:
                ++result;
                if (input_value <= 0) return result;
                state = 1;
                break;
            case 1:
                result += 10;
                --input_value;
                state = input_value > 5 ? 2 : input_value > 0 ? 1 : 0;
                break;
            case 2:
                result += 100;
                input_value -= 2;
                state = input_value > 10 ? 3 : 1;
                break;
            default:
                return result + 1003;
        }
    }
}

void main() {
    const int values[] = int[](10, -5, 150, 42, 50);
    int64_t sink = 0;
    for (int i = 0; i < 50000; ++i) {
        sink += basic_jump(i % 10);
        sink += nested_jump(5);
        sink += process_with_errors(values[i % 5]);
        sink += multi_jump(i);
        if (i % 100 == 0) sink += jump_loop(20);
        if (i % 500 == 0) sink += coroutine_switches(10);
        sink += use_resources(i % 6);
        sink += jump_state_machine(i % 20);
    }

    output_data.words[0] = 0;
    for (uint i = 0; i < 8; ++i)
        output_data.words[1+i] = uint((uint64_t(sink) >> (8u*i)) & 255UL);
}
